    <Ssera.Client.Infra.Components.MultiSelectCheckBoxList
        T="GroupMember"
        Data="@_allMembers"
        @bind-Values="@_viewModel.Members"
        ColumnCount="2"
        Style="height: min-content; gap: 10px"
     />

