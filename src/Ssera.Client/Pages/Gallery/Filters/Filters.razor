@using Ssera.Shared.Data
@using Ssera.Shared.Images.Filters

<RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap">

    <RadzenStack Orientation="Orientation.Vertical">
        <RadzenDropDown
            Data="@_allOrderByTypes"
            TextProperty="@nameof(KeyValuePair<,>.Key)"
            ValueProperty="@nameof(KeyValuePair<,>.Value)"
            @bind-Value="@_viewModel.OrderByType"
        />

        <RadzenDropDown
            Data="@_allSortTypes"
            TextProperty="@nameof(KeyValuePair<,>.Key)"
            ValueProperty="@nameof(KeyValuePair<,>.Value)"
            @bind-Value="@_viewModel.SortType"
        />
    </RadzenStack>

