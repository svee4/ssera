@inherits LayoutComponentBase

<HeadContent>
    <RadzenTheme
        Theme="@_theme"
        @rendermode="RenderMode.InteractiveWebAssembly"
    />
</HeadContent>

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack
            Style="height: 100%; padding: 6px;"
            Orientation="Orientation.Horizontal"
            JustifyContent="JustifyContent.SpaceBetween"
            AlignItems="AlignItems.Center"
        >
            <div></div>

            <RadzenStack Orientation="Orientation.Horizontal">
                <RadzenLink Path="/">Home</RadzenLink>
                <RadzenLink Path="/events">Events</RadzenLink>
                <RadzenLink Path="/gallery">Gallery</RadzenLink>
                <RadzenLink Path="/history">History</RadzenLink>
            </RadzenStack>

            <div>
                <RadzenDropDown
                    TValue="string"
                    Data="Ssera.Client.Infra.ThemeService.Themes"
                    AllowSelectAll="false"
                    Value="_theme"
                    Change="@(v => SetTheme((string)v))"
                />
            </div>
        </RadzenStack>
    </RadzenHeader>

    <RadzenBody>
        <div data-theme="@ThemeMode">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

<RadzenComponents />
