@page "/gallery"
@using Ssera.Client.Infra.Components

<PageTitle>Gallery</PageTitle>

<RadzenStack Orientation="Orientation.Vertical">
    <Ssera.Client.Pages.Gallery.Filters.Filters
        @ref="@_filtersComponent"
        OnApplyFilters="OnFiltersChanged"
        Loading="Loading"
    />

    <SseraError Error="_error" />

    <SseraPagingControls
        Page="_page"
        PageChanged="OnPageChanged"
        PageSize="@_filters.PageSize"
        TotalResults="_totalResults"
    />

    <Results
        Images="@Images"
        Loading="@Loading"
    />

    <SseraPagingControls
        Page="_page"
        PageChanged="OnPageChanged"
        PageSize="@_filters.PageSize"
        TotalResults="_totalResults"
    />
</RadzenStack>
