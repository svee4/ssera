@{
    var style = $@"
--image-width: {ImageWidth}px;
--row-height: {RowHeight}px;
--row-gap: {RowGap}px;
".ReplaceLineEndings(" ");
}

@if (Loading)
{
    <RadzenProgressBarCircular
        Style="align-self: center;"
        ProgressBarStyle="ProgressBarStyle.Primary"
        Mode="ProgressBarMode.Indeterminate"
        ShowValue="false"
    />
}

<div
    class="masonry-container"
    Style="@style"
>
    @foreach (var image in Images)
    {
        <div class="masonry-element">
            <p class="tags">
                <span class="date">@image.Date.ToShortDateString()</span>

                @{
                    var tags = GetTags(image);
                }

                @if (tags.Count > 1)
                {
                    <span class="primary-tag">@tags[0], </span>
                    @string.Join(", ", tags.Skip(1))
                }
                else if (tags.Count == 1)
                {
                    <span class="primary-tag">@tags[0]</span>
                }
            </p>

            <a
                class="image-container"
                href="@GetDriveUrl(image.Id)"
            >
                <img
                    class="image"
                    src="@GetDriveThumbnailUrl(image.Id)"
                    loading="lazy"
                />
            </a>
        </div>
    }
</div>
