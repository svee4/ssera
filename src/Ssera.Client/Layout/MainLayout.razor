@inherits LayoutComponentBase

<HeadContent>
    <RadzenTheme Theme="@_theme" @rendermode="RenderMode.InteractiveWebAssembly" />
</HeadContent>

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack
            Style="height: 100%; padding: 6px;"
            Orientation="Orientation.Horizontal"
            JustifyContent="JustifyContent.SpaceBetween"
            AlignItems="AlignItems.Center">

            <div></div>

            <RadzenStack Orientation="Orientation.Horizontal">
                <RadzenLink Target="/">Home</RadzenLink>
                <RadzenLink Target="/events">Events</RadzenLink>
                <RadzenLink Target="/gallery">Gallery</RadzenLink>
                <RadzenLink Target="/log">Log</RadzenLink>
            </RadzenStack>

            <div>
                <RadzenDropDown TValue="string"
                                Data="Ssera.Client.Infra.ThemeService.Themes"
                                AllowSelectAll="false"
                                Value="_theme"
                                Change="@(v => SetTheme((string)v))"></RadzenDropDown>
            </div>

        </RadzenStack>
    </RadzenHeader>

    <RadzenBody>
        @Body
    </RadzenBody>
</RadzenLayout>

<RadzenComponents />
