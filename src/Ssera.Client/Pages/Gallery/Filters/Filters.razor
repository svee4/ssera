@using Ssera.Client.Infra.Components
@using Ssera.Shared.Data
@using Ssera.Shared.Images.Filters

<RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap">

    <SseraFieldset Title="Order by">
        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenDropDown
                Data="@_allOrderByTypes"
                TextProperty="@nameof(KeyValuePair<,>.Key)"
                ValueProperty="@nameof(KeyValuePair<,>.Value)"
                @bind-Value="@_viewModel.OrderByType"
            />

            <RadzenDropDown
                Data="@_allSortTypes"
                TextProperty="@nameof(KeyValuePair<,>.Key)"
                ValueProperty="@nameof(KeyValuePair<,>.Value)"
                @bind-Value="@_viewModel.SortType"
            />
        </RadzenStack>
    </SseraFieldset>

    <SseraFieldset Title="Eras" Variant="@_designVariant">
        <SseraMultiSelectCheckBoxList
            Data="@_allEras"
            @bind-Values="@_viewModel.Eras"
            ColumnCount="3"
        />
    </SseraFieldset>

    <SseraFieldset Title="Members" Variant="@_designVariant">
        <SseraMultiSelectCheckBoxList
            Data="@_allMembers"
            @bind-Values="@_viewModel.Members"
            ColumnCount="3"
         />
    </SseraFieldset>

    <!-- TODO: filtering based on date -->

    <SseraFieldset Title="Tags" Style="">
        <RadzenStack Orientation="Orientation.Vertical">

            <RadzenDropDown
                @bind-Value="_viewModel.TagsSelectionType"
                Data="@_allTagsSelectionTypes"
                TextProperty="@nameof(KeyValuePair<,>.Key)"
                ValueProperty="@nameof(KeyValuePair<,>.Value)"
            />

            <RadzenDropDown
                TValue="IEnumerable<string>"
                Data="@_tagsDropdownData"
                @bind-Value="@_viewModel.Tags"
                Placeholder="Select tags"
                Multiple="true"
                AllowFiltering="true"
                AllowClear="true"
                AllowSelectAll="true"
                LoadData="@TagsDropdownLoadData"
            />

        </RadzenStack>
    </SseraFieldset>

    <RadzenButton
        Click="ApplyFilters"
        Text="Apply filters"
        ButtonStyle="ButtonStyle.Primary"
        Style="height: min-content;"
    />

</RadzenStack>
